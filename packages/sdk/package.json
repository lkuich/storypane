{
  "name": "@storypane/sdk",
  "version": "0.1.0-rc.5",
  "type": "module",
  "description": "Published content delivery and live visual preview for Storypane",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "bin": {
    "storypane": "./bin/storypane.mjs"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "import": "./dist/rich-text.js"
    },
    "./management": {
      "types": "./dist/management.d.ts",
      "import": "./dist/management.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "lint": "pnpm --workspace-root exec eslint packages/sdk --max-warnings 0 && pnpm --workspace-root exec prettier packages/sdk --check"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/react": "^19",
    "react": "19.3.1",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkuich/storypane.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://storypane.dev/docs/sdk/",
  "bugs": {
    "url": "https://github.com/lkuich/storypane/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "rc"
  }
}

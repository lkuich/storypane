    "@storypane/db": "workspace:*",
    "@storypane/ui": "workspace:*",
    "@tiptap/pm": "latest",
    "@tiptap/react": "latest",
    "@tiptap/starter-kit": "latest",
    "lucide-react": "latest",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.2",
    "@storypane/runtime-node": "workspace:*",
    "tsx": "^4.23.0",
    "ws": "^8.18.0",
    "@storypane/realtime": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",

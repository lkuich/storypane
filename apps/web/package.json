{
  "name": "@storypane/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/dev-node.ts",
    "build": "vite build",
    "lint": "pnpm --workspace-root exec eslint apps/web --max-warnings 0 && pnpm --workspace-root exec prettier apps/web --check",

---
import '../styles/site.css';
import type { pageMetadata } from '../lib/seo';
interface Props {
  title: string;
  locale?: string;
  preview?: boolean;
  metadata?: ReturnType<typeof pageMetadata>;
}
const { title, locale, preview = false, metadata } = Astro.props;
---

<!doctype html>
<html lang={locale || 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={
        metadata?.description ||
        'Fieldwork — a small studio for big ideas. An Astro site powered by Storypane.'
      }
    />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    {metadata && !preview && (
      <>
        <meta name="robots" content={metadata.robots} />
        <link rel="canonical" href={metadata.canonical} />
        <meta property="og:title" content={metadata.title} />
        <meta property="og:description" content={metadata.description} />
        <meta property="og:url" content={metadata.canonical} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content={metadata.image ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={metadata.title} />
        <meta name="twitter:description" content={metadata.description} />
        {metadata.image && (
          <>
            <meta property="og:image" content={metadata.image.url} />
            <meta property="og:image:alt" content={metadata.image.alt} />
            <meta name="twitter:image" content={metadata.image.url} />
            <meta name="twitter:image:alt" content={metadata.image.alt} />
          </>
        )}
        {metadata.markdownEnabled && (
          <link rel="alternate" type="text/markdown" href={metadata.markdownPath} />
        )}
      </>
    )}
    <title>{title} · Fieldwork</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%23232e27'/%3E%3Ctext x='14' y='48' fill='%23e6ee9c' font-size='44' font-family='Georgia'%3Ef%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <slot />
  </body>
</html>

---
import type { StorypaneStory } from '@storypane/sdk';
import type { StorypaneContentType } from '../types/storypane';
import Story from '../components/Story';
import Layout from '../layouts/Layout.astro';
import { publishedPages,cmsUrl,spaceId } from '../lib/cms';
export const getStaticPaths = publishedPages;
interface Props { story:StorypaneStory<StorypaneContentType> }
const { story } = Astro.props;
---
<Layout title={story.name} locale={story.locale}>
  <Story client:load initial={story} cmsUrl={cmsUrl} spaceId={spaceId} />
</Layout>

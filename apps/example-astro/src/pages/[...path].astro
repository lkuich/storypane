---
import type { StorypaneStory } from '@storypane/sdk';
import type { StorypaneContentType } from '../types/storypane';
import Story from '../components/Story';
import Layout from '../layouts/Layout.astro';
import { publishedPages, cmsUrl, spaceId } from '../lib/cms';
import type { SiteReferences } from '../lib/content';
export const getStaticPaths = publishedPages;
interface Props {
  story: StorypaneStory<StorypaneContentType>;
  references: SiteReferences;
}
const { story, references } = Astro.props;
---

<Layout title={story.name} locale={story.locale}>
  <Story
    client:load
    initial={story}
    references={references}
    cmsUrl={cmsUrl}
    spaceId={spaceId}
    previewParameter={import.meta.env.PUBLIC_STORYPANE_PREVIEW_PARAMETER || 'storypane_preview'}
    previewEnabled={import.meta.env.PUBLIC_STORYPANE_PREVIEW}
  />
</Layout>

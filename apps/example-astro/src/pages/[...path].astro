---
import type { StorypaneStory } from '@storypane/sdk';
import type { StorypaneContentType } from '../types/storypane';
import { Content } from '../components/content';
import Layout from '../layouts/Layout.astro';
import { publishedPages } from '../lib/cms';
import type { SiteReferences } from '../lib/content';
export const getStaticPaths = publishedPages;
interface Props {
  story: StorypaneStory<StorypaneContentType>;
  references: SiteReferences;
}
const { story, references } = Astro.props;
---

<Layout title={story.name} locale={story.locale}>
  <Content block={story.content} references={references} />
</Layout>

<script>
  // Keep image failure recovery without hydrating the public page's React tree.
  for (const image of document.querySelectorAll<HTMLImageElement>('.hero-image')) {
    const fallback = () => {
      image.parentElement!.hidden = true;
      image.parentElement!.nextElementSibling!.removeAttribute('hidden');
    };
    image.addEventListener('error', fallback, { once: true });
    if (image.complete && !image.naturalWidth) fallback();
  }
</script>

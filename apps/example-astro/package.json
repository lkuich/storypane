{
  "name": "@blok/example-astro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 3132",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 3132",
    "typecheck": "astro check",
    "blok:pull": "node --env-file-if-exists=.env ../../packages/sdk/bin/blok.mjs pull-components --out blok/components.json",
    "blok:types": "blok generate-types --input blok/components.json --out src/types/blok.ts",
    "blok:generate": "pnpm blok:pull && pnpm blok:types"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@blok/sdk": "workspace:*",
    "astro": "^7.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^6.0.3"
  }
}

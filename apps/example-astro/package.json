{
  "name": "@storypane/example-astro",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "cd ../.. && node --env-file-if-exists=.env --import tsx scripts/setup-astro-example.ts && pnpm --filter @storypane/sdk build && pnpm --filter @storypane/example-astro storypane:generate",
    "lint": "pnpm --workspace-root exec eslint apps/example-astro --max-warnings 0 && pnpm --workspace-root exec prettier apps/example-astro --check",
    "dev": "astro dev --host 127.0.0.1 --port 3132",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 3132",
    "typecheck": "astro check",
    "storypane:pull": "node --env-file-if-exists=.env ../../packages/sdk/bin/storypane.mjs pull-components --out storypane/components.json",
    "storypane:types": "storypane generate-types --input storypane/components.json --out src/types/storypane.ts",
    "storypane:generate": "pnpm storypane:pull && pnpm storypane:types"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@storypane/sdk": "workspace:*",
    "astro": "^7.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}

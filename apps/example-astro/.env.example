# Run `pnpm --filter @storypane/example-astro setup` from the repo root to create a local example space.
STORYPANE_URL=http://127.0.0.1:3130
# Optional separate delivery service; previews and schema tooling keep using STORYPANE_URL.
STORYPANE_DELIVERY_URL=
STORYPANE_SPACE_ID=
STORYPANE_DELIVERY_TOKEN=
# Only used by the schema CLI. Never expose this with a PUBLIC_ prefix.
STORYPANE_PREVIEW_TOKEN=
# Locales and their URL prefixes are discovered from Space settings.

# Public frontend origin for canonical URLs, social images, and Markdown discovery.
SITE_URL=http://127.0.0.1:3132

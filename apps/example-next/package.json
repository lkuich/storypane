{
  "name": "@storypane/example-next",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3133",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3133",
    "typecheck": "next typegen && tsc --noEmit",
    "storypane:pull": "node --env-file-if-exists=.env ../../packages/sdk/bin/storypane.mjs pull-components --out storypane/components.json",
    "storypane:types": "storypane generate-types --input storypane/components.json --out src/types/storypane.ts",
    "storypane:generate": "pnpm storypane:pull && pnpm storypane:types",
    "lint": "pnpm --workspace-root exec eslint apps/example-next --max-warnings 0 && pnpm --workspace-root exec prettier apps/example-next --check"
  },
  "dependencies": {
    "@storypane/sdk": "workspace:*",
    "next": "^16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^6.0.3"
  }
}

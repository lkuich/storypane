# Copy to ignored .env.production. This release runs on Node/Docker/Railway.
AUTH_PROVIDER=local
STORYPANE_APP_URL=https://cms.example.com
INSTALLATION_DATABASE_URL=
# Separate credentials; used only by installation-admin provisioning.
PROVISIONING_DATABASE_URL=
# Generate each key independently with openssl rand -base64 32; retain on upgrades.
INSTALLATION_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
WEBHOOK_ENCRYPTION_KEY=
# Optional Clerk provider: set AUTH_PROVIDER=clerk explicitly.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional SMTP: omit both for manual invitations and CLI recovery.
SMTP_URL=
MAIL_FROM=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
EXTERNAL_OPTION_HOSTS=
WEBHOOK_HOSTS=
# compose.node.yaml only: URL-safe database passwords, generated once.
PROVISIONING_DB_PASSWORD=
INSTALLATION_DB_PASSWORD=
PORT=3130

# Copy to .env.production (ignored). Use a separate database for each installation.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_SUBDOMAIN=
DATABASE_URL=
STORYPANE_WEB_WORKER_NAME=storypane-web
STORYPANE_REALTIME_WORKER_NAME=storypane-realtime
R2_BUCKET=storypane-assets
# Optional reconnect: Hyperdrive must use DATABASE_URL and have caching disabled.
HYPERDRIVE_ID=
# Omit these to use your own Workers URL. Custom domain must belong to this account.
STORYPANE_APP_URL=
STORYPANE_DOMAIN=
# Existing installations must supply their original encryption key in this file.
STORYPANE_SECRETS_FILE=.env.production.secrets.json
EXTERNAL_OPTION_HOSTS=
WEBHOOK_HOSTS=

# Local development only. Compose works with these defaults without a .env file.
POSTGRES_USER=blok
POSTGRES_PASSWORD=blok
POSTGRES_DB=blok
POSTGRES_PORT=55432
DATABASE_URL=postgresql://blok:blok@127.0.0.1:55432/blok
BLOK_APP_URL=http://127.0.0.1:3130
# Comma-separated public HTTPS hostnames permitted for external option sources.
EXTERNAL_OPTION_HOSTS=

# Selected by the project owner. Never rely on a CLI's default account.
CLOUDFLARE_ACCOUNT_ID=c813587edc389800e834e0c261a91ef5

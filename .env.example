# Legacy fixture databases only; docker compose -f compose.yaml uses these defaults.
POSTGRES_USER=storypane
POSTGRES_PASSWORD=storypane
POSTGRES_DB=storypane
POSTGRES_PORT=55432
DATABASE_URL=postgresql://storypane:storypane@127.0.0.1:55432/storypane
TEST_DATABASE_URL=postgresql://storypane:storypane@127.0.0.1:55432/storypane_test
COMPOSE_PROJECT_NAME=storypane
STORYPANE_APP_URL=http://127.0.0.1:3130
# Production startup only: combined (default), or a separately replicated delivery service.
STORYPANE_SERVICE=combined
# Comma-separated public HTTPS hostnames permitted for external option sources.
EXTERNAL_OPTION_HOSTS=
# Exact operator-approved public HTTPS webhook hosts (separate from option sources).
WEBHOOK_HOSTS=
# Set WEBHOOK_ENCRYPTION_KEY below for the Node runtime.
# Generate Node configuration with: node scripts/setup-env.mjs --local

# Node development uses a separate control database and dedicated space databases.
# Follow docs/self-hosting.md; DATABASE_URL above is only for legacy fixtures/tests.
AUTH_PROVIDER=local
PROVISIONING_DB_PASSWORD=
INSTALLATION_DB_PASSWORD=
# Use the generated passwords above in host URLs on 127.0.0.1:55450.
INSTALLATION_DATABASE_URL=
PROVISIONING_DATABASE_URL=
INSTALLATION_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
WEBHOOK_ENCRYPTION_KEY=
S3_ENDPOINT=http://127.0.0.1:59120
S3_REGION=us-east-1
S3_BUCKET=storypane
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# SMTP_URL and MAIL_FROM are optional; no mail server is needed.

{
  "name": "storypane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @storypane/web dev",
    "dev:example": "pnpm --filter @storypane/sdk build && pnpm --filter @storypane/example-astro dev",
    "dev:example:next": "pnpm --filter @storypane/sdk build && pnpm --filter @storypane/example-next dev",
    "example:setup:next": "tsx scripts/setup-next-example.ts",
    "lint:example": "eslint apps/example-astro apps/example-next --max-warnings 0 && prettier apps/example-astro apps/example-next --check",
    "build:example:next": "pnpm --filter @storypane/sdk build && pnpm --filter @storypane/example-next build",
    "example:setup": "tsx scripts/setup-astro-example.ts && pnpm --filter @storypane/sdk build && pnpm --filter @storypane/example-astro storypane:generate",
    "build:example": "pnpm --filter @storypane/sdk build && pnpm --filter @storypane/example-astro build",
    "build": "pnpm --filter @storypane/sdk build && pnpm --filter @storypane/web build",
    "types": "pnpm --filter @storypane/web exec cf workers types",
    "typecheck": "pnpm --filter @storypane/sdk build && pnpm types && tsc --noEmit && pnpm --filter @storypane/example-astro typecheck && pnpm --filter @storypane/example-next typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "docker compose up -d --wait",
    "db:setup": "tsx scripts/setup.ts",
    "db:test": "tsx scripts/test-database.ts",
    "lint": "pnpm lint:code && pnpm format:check",
    "lint:fix": "pnpm lint:code --fix && pnpm format",
    "lint:code": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@storypane/core": "workspace:*",
    "@storypane/db": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "latest",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "latest",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}

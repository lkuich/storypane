{
  "name": "storypane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @storypane/web dev",
    "build": "pnpm --filter @storypane/sdk build && pnpm --filter @storypane/web build",
    "typecheck": "pnpm --filter @storypane/sdk build && tsc --noEmit && pnpm --filter './apps/example-*' typecheck",
    "test": "pnpm test:setup && vitest run",
    "test:setup": "node --test scripts/setup-env.test.mjs",
    "test:e2e": "playwright test",
    "db:start": "docker compose --env-file .env -f compose.node.yaml -f compose.node.local.yaml -p storypane-local up -d --wait postgres media media-init",
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/setup.ts",
    "db:test": "node --env-file-if-exists=.env --import tsx scripts/test-database.ts",
    "lint": "pnpm lint:code && pnpm format:check",
    "lint:fix": "pnpm lint:code --fix && pnpm format",
    "lint:code": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:migrate:production": "node --env-file-if-exists=.env.production --import tsx scripts/migrate-production.ts",
    "admin": "node --env-file-if-exists=.env.production --import tsx scripts/admin.ts",
    "start": "pnpm --filter @storypane/web start"
  },
  "dependencies": {
    "@storypane/core": "workspace:*",
    "@storypane/db": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "latest",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "latest",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "license": "MIT"
}

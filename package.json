{
  "name": "storypane",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @storypane/web dev",
    "dev:example": "pnpm --filter @storypane/sdk build && pnpm --filter @storypane/example-astro dev",
    "example:setup": "tsx scripts/setup-astro-example.ts && pnpm --filter @storypane/sdk build && pnpm --filter @storypane/example-astro storypane:generate",
    "build:example": "pnpm --filter @storypane/sdk build && pnpm --filter @storypane/example-astro build",
    "build": "pnpm --filter @storypane/sdk build && pnpm --filter @storypane/web build",
    "types": "pnpm --filter @storypane/web exec cf workers types",
    "typecheck": "pnpm --filter @storypane/sdk build && pnpm types && tsc --noEmit && pnpm --filter @storypane/example-astro typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "docker compose up -d --wait",
    "db:setup": "tsx scripts/setup.ts",
    "db:test": "tsx scripts/test-database.ts"
  },
  "dependencies": {
    "@storypane/core": "workspace:*",
    "@storypane/db": "workspace:*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.0",
    "typescript": "latest",
    "vitest": "latest"
  }
}
